<%# locals: (form:) %>
<div class="space-y-2 p-3">
  <%= form.date_field :start_date,
                      placeholder: t(".start_date"),
                      value: @q[:start_date],
                      class: "block w-full rounded-md border border-secondary bg-container py-2 pl-3 pr-3 focus:ring-gray-500 sm:text-sm" %>

  <%= form.date_field :end_date,
                      placeholder: t(".end_date"),
                      value: @q[:end_date],
                      class: "block w-full rounded-md border border-secondary bg-container py-2 pl-3 pr-3 focus:ring-gray-500 sm:text-sm" %>
</div>
