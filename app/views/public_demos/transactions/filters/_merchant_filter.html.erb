<%# locals: (form:) %>
<div data-controller="list-filter">
  <div class="relative">
    <input type="search" autocomplete="off" placeholder="<%= t('.placeholder') %>" data-list-filter-target="input" data-action="input->list-filter#filter" class="block w-full rounded-md border border-secondary bg-container py-2 pl-10 pr-3 focus:ring-gray-500 sm:text-sm">
    <%= icon("search", class: "absolute inset-y-0 left-2 top-1/2 -translate-y-1/2 transform") %>
  </div>

  <div class="my-2" data-list-filter-target="list">
    <% @demo_merchants.each do |merchant| %>
      <div class="filterable-item flex items-center gap-2 p-2" data-filter-name="<%= merchant.name %>">
        <%= form.check_box :merchants,
                           {
                             multiple: true,
                             checked: @q[:merchants]&.include?(merchant.name),
                             class: "checkbox checkbox--light"
                           },
                           merchant.name,
                           nil %>
        <%= form.label :merchants, value: merchant.name, class: "flex cursor-pointer items-center gap-2 text-sm text-primary" do %>
          <%= render DS::FilledIcon.new(
            variant: :text,
            hex_color: merchant.color,
            text: merchant.name,
            size: "sm",
            rounded: true
          ) %>
          <%= merchant.name %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
