<%= form_with url: public_demo_transactions_path(@demo_slug),
              id: "public-demo-transactions-search",
              scope: :q,
              method: :get,
              data: { controller: "auto-submit-form" } do |form| %>
  <%= hidden_field_tag :locale, @demo_locale %>
  <%= hidden_field_tag :per_page, params[:per_page] %>

  <div class="flex flex-col gap-2 lg:flex-row">
    <div class="grow">
      <div class="flex items-center gap-2 rounded-xl border border-secondary px-3 py-2 focus-within:border-secondary focus-within:ring-secondary">
        <%= icon("search") %>
        <%= form.text_field :search,
                            placeholder: t("public_demos.transactions.search_placeholder"),
                            value: @q[:search],
                            class: "form-field__input placeholder:text-sm placeholder:text-secondary",
                            "data-auto-submit-form-target": "auto" %>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <%= render DS::Menu.new(variant: "button", no_padding: true) do |menu| %>
        <% menu.with_button(
          id: "public-demo-transaction-filters-button",
          type: "button",
          text: t("public_demos.transactions.filter"),
          variant: "outline",
          icon: "list-filter"
        ) %>

        <% menu.with_custom_content do %>
          <%= render "public_demos/transactions/menu", form: form %>
        <% end %>
      <% end %>

      <% if @q.present? %>
        <%= render DS::Link.new(
          text: t("public_demos.transactions.clear_filters"),
          variant: "ghost",
          href: public_demo_transactions_path(@demo_slug, locale: @demo_locale)
        ) %>
      <% end %>
    </div>
  </div>
<% end %>

<ul class="mt-4 flex flex-wrap items-center gap-2">
  <% @q.reject { |key| key.to_s == "amount_operator" }.each do |param_key, param_value| %>
    <% next if param_value.blank? %>

    <% if param_key == :amount %>
      <% amount_operator = case @q[:amount_operator]
                           when "equal"
                             t("public_demos.transactions.equal_to")
                           when "greater"
                             t("public_demos.transactions.greater_than")
                           when "less"
                             t("public_demos.transactions.less_than")
                           else
                             t("public_demos.transactions.equal_to")
                           end %>
      <%= render "public_demos/transactions/filter_badge", param_key: "amount", param_value: "#{amount_operator} #{param_value}" %>
    <% else %>
      <% Array(param_value).each do |value| %>
        <%= render "public_demos/transactions/filter_badge", param_key: param_key.to_s, param_value: value %>
      <% end %>
    <% end %>
  <% end %>
</ul>
