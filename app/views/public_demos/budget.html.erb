<% title t(".page_title", demo_name: @demo_title) %>

<div class="w-full space-y-6 pb-12">
  <section class="rounded-2xl bg-container px-5 py-5 shadow-border-xs lg:px-6 lg:py-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="space-y-1">
        <h2 class="text-xl font-medium text-primary lg:text-2xl"><%= t(".heading") %></h2>
        <p class="max-w-3xl text-sm text-secondary lg:text-base"><%= t(".description") %></p>
      </div>

      <div class="flex items-center gap-2">
        <% if @budget.previous_budget_param %>
          <%= render DS::Link.new(
            variant: "icon",
            icon: "chevron-left",
            href: public_demo_budget_path(@demo_slug, locale: @demo_locale, month_year: @budget.previous_budget_param)
          ) %>
        <% else %>
          <span class="text-subdued"><%= icon "chevron-left", color: "current" %></span>
        <% end %>

        <div class="rounded-xl border border-secondary px-4 py-2 text-sm font-medium text-primary">
          <%= @budget_name %>
        </div>

        <% if @budget.next_budget_param %>
          <%= render DS::Link.new(
            variant: "icon",
            icon: "chevron-right",
            href: public_demo_budget_path(@demo_slug, locale: @demo_locale, month_year: @budget.next_budget_param)
          ) %>
        <% else %>
          <span class="text-subdued"><%= icon "chevron-right", color: "current" %></span>
        <% end %>

        <%= render DS::Link.new(
          text: t(".today"),
          variant: "outline",
          href: public_demo_budget_path(@demo_slug, locale: @demo_locale, month_year: Budget.date_to_param(Date.current))
        ) %>
      </div>
    </div>
  </section>

  <div class="flex flex-col items-start gap-4 md:flex-row">
    <div class="w-full space-y-4 md:max-w-[300px]">
      <div class="h-[300px] rounded-xl bg-container p-8 shadow-border-xs">
        <%= render "public_demos/budget_donut", budget: @budget %>
      </div>

      <div class="rounded-xl bg-container shadow-border-xs">
        <%= render "public_demos/budget_budgeted_summary", budget: @budget %>
      </div>

      <div class="rounded-xl bg-container shadow-border-xs">
        <%= render "public_demos/budget_actuals_summary", budget: @budget %>
      </div>
    </div>

    <div class="w-full grow rounded-xl bg-container p-4 shadow-border-xs">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-medium text-primary"><%= t(".categories.heading") %></h3>
        <p class="text-sm text-secondary"><%= t(".categories.read_only") %></p>
      </div>

      <div class="rounded-xl bg-container-inset p-1">
        <%= render "public_demos/budget_categories", budget: @budget %>
      </div>
    </div>
  </div>
</div>
